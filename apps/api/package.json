{
  "name": "@execloom/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "NODE_OPTIONS='--conditions=development' tsx watch src/server.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS='--conditions=development' node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@execloom/config": "workspace:*",
    "@execloom/contracts": "workspace:*",
    "@execloom/db": "workspace:*",
    "@execloom/queue": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jose": "^6.2.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
